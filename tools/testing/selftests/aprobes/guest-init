/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
echo APROBES_GUEST_KERNEL
/bin/busybox uname -a
/aprobes-test
result=$?
echo APROBES_GUEST_TEST_EXIT=$result
/bin/busybox dmesg | /bin/busybox grep -E 'BUG:|WARNING:|Oops:|kernel BUG|KASAN:'
/bin/busybox sync
/bin/busybox poweroff -f
